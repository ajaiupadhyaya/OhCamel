# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Reactive real-time risk and limits engine"
description:
  "A risk and limits engine built on self-adjusting computation. Risk quantities (exposure, VaR, expected shortfall, limit breaches) are nodes in an Incremental dependency graph: when a tick or fill changes one input, only the nodes downstream of that change recompute. There is no polling loop."
maintainer: ["Ajai Upadhyaya"]
authors: ["Ajai Upadhyaya"]
license: "MIT"
homepage: "https://github.com/ajaiupadhyaya/OhCamel"
bug-reports: "https://github.com/ajaiupadhyaya/OhCamel/issues"
depends: [
  "dune" {>= "3.16"}
  "ocaml" {>= "5.1.0"}
  "core" {>= "v0.17.0"}
  "async" {>= "v0.17.0"}
  "incremental" {>= "v0.17.0"}
  "owl" {>= "1.2"}
  "cohttp-async" {>= "6.2.0"}
  "alcotest" {with-test & >= "1.9.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/ajaiupadhyaya/OhCamel.git"
