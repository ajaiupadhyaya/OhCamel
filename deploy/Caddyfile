# OhCamel behind Caddy, in production.
#
# Two hosts. The public one serves OhCamel Quant (ohcamel-quant: FastAPI + the
# React SPA, real market data only -- no synthetic feed, no simulated market).
# The gated one serves the OCaml engine against Alpaca and FRED, exactly as
# before. The synthetic demo engine is no longer routed anywhere in
# production. The public host's variable keeps its old name,
# OHCAMEL_DEMO_HOST, so an existing deploy/.env keeps working unchanged.
#
# Hostnames, the ACME contact and the basic-auth credential arrive as
# environment variables (Caddy's {$VAR} syntax) rather than being written here,
# so this file is safe in a public repository. docker-compose.yml passes them
# in; deploy/deploy.env.example lists them.
#
# The streaming configuration, and the Quant site's headers (CSP, caching),
# live in Caddyfile.snippets, which the localhost harness imports too -- read
# the comments there before changing anything about how /api/stream is proxied
# or what the Content-Security-Policy allows.
{
	email {$OHCAMEL_ACME_EMAIL}
}

import Caddyfile.snippets

# ---------------------------------------------------------------------------
# Public -- OhCamel Quant
# ---------------------------------------------------------------------------
{$OHCAMEL_DEMO_HOST} {
	import ohcamel_common

	# Only in production: HSTS is a promise that this host will keep speaking
	# HTTPS, and it must not be made by the localhost harness, which cannot.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	import ohcamel_quant
}

# ---------------------------------------------------------------------------
# Gated -- the live engine
# ---------------------------------------------------------------------------
#
# The password is why this host exists separately. Live mode holds Alpaca and
# FRED credentials and shows a real book; the demo holds nothing and shows a
# generated one. OHCAMEL_LIVE_HASH is a bcrypt hash from `caddy hash-password`,
# never a plaintext password -- see deploy/deploy.env.example.
{$OHCAMEL_LIVE_HOST} {
	import ohcamel_common

	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	basic_auth {
		{$OHCAMEL_LIVE_USER} {$OHCAMEL_LIVE_HASH}
	}

	reverse_proxy ohcamel-live:8081 {
		import ohcamel_stream_proxy
	}
}
