# Copy to deploy/.env on the droplet. Read by docker compose (which reads
# `.env` from the directory holding the compose file) and passed through to
# Caddy, which reads them as {$VAR}.
#
# This file holds NO secrets: hostnames, an ACME contact, and a bcrypt hash.
# Alpaca and FRED credentials live somewhere else entirely --
# /etc/ohcamel/live.env, root-owned and 0600 -- because these values are
# convenience and those are not.

# Where Let's Encrypt sends expiry warnings. A real address; an unread one
# means the first warning about a renewal failure is the site going down.
OHCAMEL_ACME_EMAIL=you@example.com

# The public host -- OhCamel Quant (real market data only). The variable keeps
# its historical name from when this host served the synthetic demo engine;
# renaming it would break every existing deploy/.env for no gain. Needs an A
# record pointing at this droplet BEFORE the first `docker compose up`, or
# Caddy's ACME challenge fails and Let's Encrypt starts counting toward the
# five-failures-per-hour limit.
OHCAMEL_DEMO_HOST=ohcamel.example.com

# The gated host. Also needs its own A record.
OHCAMEL_LIVE_HOST=live.ohcamel.example.com

# Basic auth on the live host.
#
# The hash, never the password. Generate it with:
#
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your password'
#
# and paste the $2a$14$... string below. Note that docker compose treats `$` as
# the start of a variable reference, so every `$` in the hash must be DOUBLED
# to `$$` in this file. A hash pasted verbatim silently becomes a different
# hash, and the symptom is a password that is simply always wrong.
#
# For the same reason this file must only ever be read by compose. Sourcing it
# into a shell turns each `$$` into a process id, and deploy.sh learned that
# the hard way -- it now reads the hostnames it needs with sed instead.
OHCAMEL_LIVE_USER=ohcamel
OHCAMEL_LIVE_HASH=$$2a$$14$$replace.this.with.a.real.hash.from.caddy.hash.password

# --- OhCamel Quant (optional; defaults shown in comments) --------------------
#
# SEC EDGAR's fair-access policy requires every client to send a User-Agent
# naming a contact; requests without one are throttled or refused. Unset, it
# defaults to "OhCamel-Quant/1.0 (research; contact: <OHCAMEL_ACME_EMAIL>)"
# (docker-compose.yml). Plain text, no `$`, so no doubling needed.
# OHCAMEL_QUANT_USER_AGENT=OhCamel-Quant/1.0 (research; contact: you@example.com)
#
# The public app's read-only bridge to the OCaml engine (GET /api/engine/*).
# Unset, it points at the live engine on the internal network
# (http://ohcamel-live:8081) and the public /engine page shows the live
# engine's snapshot -- which includes the book's positions. Set it EMPTY to
# switch the bridge off (the page then says the engine is unavailable):
# OHCAMEL_QUANT_ENGINE_URL=
