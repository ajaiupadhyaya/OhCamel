# Fires ohcamel-watch.service every 5 minutes, on the wall clock's fives
# (finish plan Task 18). Not Persistent: a watch run missed while the host
# was down has nothing to catch up on -- the next one checks the present.
# A oneshot still running when the timer fires is not started twice.
#
# Enabled by the owner: systemctl enable --now ohcamel-watch.timer, and
# `systemctl list-timers 'ohcamel-*'` shows the next firing. `User=` is a
# [Service] directive and lives in ohcamel-watch.service.

[Unit]
Description=Run ohcamel-watch.service every 5 minutes

[Timer]
OnCalendar=*:0/5
AccuracySec=10s
Unit=ohcamel-watch.service

[Install]
WantedBy=timers.target
