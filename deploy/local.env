# Values for the localhost harness only. Committed on purpose: there is nothing
# here worth protecting, and requiring a hand-written file to run
# `make deploy-verify` would mean the verification step gets skipped.
#
# docker-compose.yml declares these with ${VAR:?...} so that a PRODUCTION
# deploy missing a hostname fails loudly at parse time rather than serving on
# an empty one. That guard fires before any override is merged, which is why
# the harness supplies values here rather than in docker-compose.local.yml.
#
# Caddyfile.local hardcodes http://localhost and never reads the two host
# variables, so their values below are placeholders that exist only to satisfy
# interpolation.

OHCAMEL_ACME_EMAIL=local@invalid
OHCAMEL_DEMO_HOST=localhost
OHCAMEL_LIVE_HOST=live.localhost
OHCAMEL_LIVE_USER=local
OHCAMEL_LIVE_HASH=unused-by-the-local-caddyfile
