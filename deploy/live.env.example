# The live engine's credentials.
#
# Install as /etc/ohcamel/live.env, root-owned, group-readable by the deploy
# user and nobody else (docker compose reads env_file as the user running it,
# not as root -- provision.sh explains):
#
#   sudo install -d -m 0750 -o root -g ohcamel /etc/ohcamel
#   sudo install -m 0640 -o root -g ohcamel /dev/null /etc/ohcamel/live.env
#   sudo vi /etc/ohcamel/live.env
#
# NOT in the repository, NOT in deploy/, NOT in the Docker build context. The
# root .dockerignore excludes .env* precisely so that a copy left in the tree
# by accident still cannot reach an image layer -- and an image layer is
# permanent, readable by anyone who pulls the image, and unaffected by deleting
# the file in a later layer.

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Optional for OhCamel Quant, which reads FRED's keyless fredgraph.csv
# endpoint when this is empty; the engine's own FRED client needs it.
FRED_API_KEY=

# OhCamel Quant (the public site) reads this file too, OPTIONALLY
# (env_file required: false in docker-compose.yml): the two Alpaca DATA keys
# above make Alpaca its first price source (its entrypoint maps them onto the
# APCA_API_KEY_ID / APCA_API_SECRET_KEY names it reads; setting those two
# directly here works as well). Without them it uses Yahoo, then Stooq. It
# never places orders: the optional trading keys below reach its environment
# with the rest of this file, and nothing in it reads them. Its SEC contact
# (OHCAMEL_QUANT_USER_AGENT) is not a secret and lives in deploy/.env.

# Optional. A separate PAPER key pair for the desk; absent, the data keys
# above are used. Either way the key must begin PK: the desk trades Alpaca
# paper only and refuses anything else before a request is sent.
# ALPACA_TRADING_API_KEY=
# ALPACA_TRADING_SECRET_KEY=

# Optional. Defaults shown; both are read by Config.Runtime.of_env.
#
#   iex  is the free feed and is what a paper account gets.
#   sip  is the consolidated tape and needs a paid subscription.
OHCAMEL_ALPACA_FEED=iex
OHCAMEL_FRED_SERIES=DGS10
