# The live engine's credentials.
#
# Install as /etc/ohcamel/live.env, root-owned, group-readable by the deploy
# user and nobody else (docker compose reads env_file as the user running it,
# not as root -- provision.sh explains):
#
#   sudo install -d -m 0750 -o root -g ohcamel /etc/ohcamel
#   sudo install -m 0640 -o root -g ohcamel /dev/null /etc/ohcamel/live.env
#   sudo vi /etc/ohcamel/live.env
#
# NOT in the repository, NOT in deploy/, NOT in the Docker build context. The
# root .dockerignore excludes .env* precisely so that a copy left in the tree
# by accident still cannot reach an image layer -- and an image layer is
# permanent, readable by anyone who pulls the image, and unaffected by deleting
# the file in a later layer.

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
FRED_API_KEY=

# Optional. Defaults shown; both are read by Config.Runtime.of_env.
#
#   iex  is the free feed and is what a paper account gets.
#   sip  is the consolidated tape and needs a paid subscription.
OHCAMEL_ALPACA_FEED=iex
OHCAMEL_FRED_SERIES=DGS10
