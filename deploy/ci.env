# The image job's dummy env_file, read through deploy/docker-compose.ci.yml
# by the two services that declare /etc/ohcamel/live.env `required: true`
# (ohcamel-live, ohcamel-research). CI only.
#
# Committed on purpose, like deploy/local.env: nothing here is a credential.
# Three visibly fake values that exist so the live profile renders and starts
# on a runner that has neither /etc/ohcamel nor a key -- the engine's first
# sync fails against them, and the image job's smoke does not read it (it
# drives the demo engine and the public Quant site). A real key never enters
# this file: deploy/test/compose_tags_test.sh refuses any value that is not
# exactly ci-dummy-not-a-key.

ALPACA_API_KEY=ci-dummy-not-a-key
ALPACA_SECRET_KEY=ci-dummy-not-a-key
FRED_API_KEY=ci-dummy-not-a-key
