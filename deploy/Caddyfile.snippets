# Shared by deploy/Caddyfile (production) and deploy/Caddyfile.local (the
# no-TLS localhost harness), and shared ON PURPOSE. The local smoke run exists
# to prove that streaming survives the proxy; if it exercised a different
# proxy configuration than production, it would prove nothing about production.
# Both files import this one, so there is exactly one place where the streaming
# behaviour is defined.

# ---------------------------------------------------------------------------
(ohcamel_common) {
	# The stream is excluded from compression. gzip works by accumulating bytes
	# before emitting a block, which is the wrong shape for a stream -- though
	# Caddy's encode module turns out to handle text/event-stream correctly on
	# its own (see the note below the header block; it was tested). The
	# exclusion stays because it costs nothing and is right against a less
	# careful proxy. Every other route is a discrete response and compresses
	# fine; the dashboard HTML is the one that actually benefits.
	# /api/jobs/events is the Quant app's SSE stream (Lane B), excluded for the
	# same reason.
	@compressible not path /api/stream /api/jobs/events
	encode @compressible zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}

	log {
		output stdout
		format console
	}
}

# ---------------------------------------------------------------------------
# Streaming, and an honest account of what these two directives are worth.
#
# The fear these were written against: a reverse proxy that buffers the SSE
# body produces a dashboard that loads, renders one snapshot from
# /api/snapshot, and then freezes. It looks exactly like an engine bug, and it
# would make the project's reactive claim unfalsifiable from outside precisely
# where it is most visible.
#
# That fear turns out to be largely unfounded on Caddy, and it was worth
# finding out rather than assuming. Three deliberate misconfigurations were
# tested against this stack, each with the smoke suite watching:
#
#   flush_interval 30s   -- longer than the whole probe window.  Still streamed.
#   encode applied to /api/stream (gzip requested by the client). Still streamed.
#   nginx with proxy_buffering on, in Caddy's place.              Still streamed.
#
# Caddy special-cases responses whose Content-Type is text/event-stream and
# flushes them immediately regardless of flush_interval; its encode module does
# the same. So these directives are defence in depth, not the thing holding the
# dashboard up.
#
# They are kept anyway, for two narrow reasons. The auto-detection keys off the
# Content-Type, so a future route that streams something which is not
# text/event-stream would get no such protection. And an explicit -1 documents
# the requirement for whoever swaps this proxy for one that is less careful --
# which is a real possibility, and the reason the smoke suite tests the
# behaviour from outside rather than trusting any of these lines.
#
# The compression exclusion below is kept on the same footing: verified
# unnecessary here, cheap, and correct against a proxy that is less thoughtful.
(ohcamel_stream_proxy) {
	flush_interval -1
	transport http {
		read_timeout 0
		write_timeout 0
	}
}

# ---------------------------------------------------------------------------
# OhCamel Quant -- the public site (FastAPI + the built React SPA).
#
# Imported by the public host in Caddyfile and by http://localhost in
# Caddyfile.local, so the harness exercises exactly these headers.
#
# One upstream serves everything: /api/* (JSON), /assets/* (Vite's hashed
# bundles) and every other path, which FastAPI answers with index.html so
# client-side routes (/portfolio, /company/AAPL ...) survive a reload. No SSE
# here, so no streaming directives; FastAPI already gzips JSON over 1 KB, and
# Caddy's encode (ohcamel_common) leaves an already-encoded body alone.
#
# The Content-Security-Policy, directive by directive -- exactly what the
# bundle needs, measured (Harden H4) by loading every route of the built SPA
# and a Plotly surface in Chromium under the policy and recording each
# securitypolicyviolation:
#   default-src 'self'        nothing external: fonts, KaTeX and Plotly are all
#                             bundled by Vite; the API is same-origin.
#   script-src 'self'         no 'unsafe-eval': Plotly 4's surface (the app's one
#                             Plotly view) renders without compiling code.
#                             Inline script is NOT allowed --
#   script-src 'sha256-...'   except the one pre-paint theme snippet in
#                             quant/web/index.html (it applies the saved theme
#                             before first paint), allowed by its exact hash.
#                             Vite copies it into dist/index.html byte for byte.
#                             deploy/test/csp_hash_test.sh fails CI if the
#                             snippet changes without this hash, and smoke.sh
#                             checks the served page against the served header.
#   style-src-elem            'self' plus the hash of the EMPTY string: Plotly
#                             creates one empty <style> and adds its rules with
#                             insertRule (CSSOM, which CSP does not govern). No
#                             other inline <style> runs (Plotly's bundled
#                             maplibre CSS is refused; the app draws no maps).
#   style-src-attr            'unsafe-inline': KaTeX's markup carries style=""
#                             attributes (vertical metrics), and so does
#                             Plotly's. uPlot needs nothing here: it styles
#                             through element.style (CSSOM).
#   style-src                 'self' 'unsafe-inline' -- read only by browsers
#                             without the CSP3 -elem/-attr split, so they still
#                             render formulas.
#   img-src data:             CSS data: images (hatching, icons) and Plotly's
#                             "download as PNG".
#   font-src data:            KaTeX's stylesheet inlines a font as a data: URI.
#   connect-src 'self'        the JSON API and the job stream (SSE,
#                             /api/jobs/events) are same-origin.
#   worker-src 'none'         nothing spawns a worker.
#   frame-ancestors 'none'    the same promise X-Frame-Options DENY makes.
#
# /api/docs (Swagger UI) is FastAPI's page, which loads swagger-ui from
# cdn.jsdelivr.net and boots it with an inline script; it gets its own looser
# policy so the interactive API docs keep working, and nothing else does.
(ohcamel_quant) {
	@quant_spa not path /api/docs /api/docs/* /api/redoc
	header @quant_spa Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-SwhT+ug7GN6bjlLRVrRAP3/MQEid6XtWbpmX1S3rY20='; style-src 'self' 'unsafe-inline'; style-src-elem 'self' 'sha256-47DEQpj8HBSa+/TImW+5JCeuQeRkm5NMpJWZG3hSuFU='; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; worker-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

	@quant_apidocs path /api/docs /api/docs/* /api/redoc
	header @quant_apidocs Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https://fastapi.tiangolo.com; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"

	header {
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
	}

	# Vite content-hashes every file under /assets, so a name never changes
	# meaning: cache for a year. Everything that is not an asset or the API --
	# index.html, served for every client route -- must be revalidated, or a
	# deploy leaves browsers holding an index.html that names deleted bundles.
	@quant_assets path /assets/*
	header @quant_assets Cache-Control "public, max-age=31536000, immutable"
	@quant_html not path /api/* /assets/*
	header @quant_html Cache-Control "no-cache"

	reverse_proxy ohcamel-quant:8090 {
		# The heaviest endpoints (optimiser sweeps, backtest sweeps) compute
		# for a while on a 2 vCPU box; fail them visibly rather than hang.
		transport http {
			dial_timeout 5s
			response_header_timeout 120s
		}
	}
}
