# Dune build output
_build/

# Coverage output from `make coverage`. Regenerated, never reviewed as a diff.
_coverage/
*.coverage

# Project-local opam switch (the compiler + all deps live here; ~2 GB)
_opam/

# opam install manifests generated by dune
*.install

# macOS
.DS_Store

# Credentials. The engine reads ALPACA_API_KEY, ALPACA_SECRET_KEY and
# FRED_API_KEY from the process environment -- it never reads a committed file.
# These patterns exist so that a local .env used for convenience cannot be
# committed by accident.
.env
*.env
!.env.example

# The live book: positions and limits are account-specific.
# book.example.sexp is committed; book.sexp is not.
book.sexp

# An earlier copy of the brief, kept for provenance but not part of the repo
# (README.md is the canonical version).
Untitled

# Deployment. deploy/.env holds hostnames and a bcrypt hash and is written on
# the droplet, never here; deploy/local.env is committed on purpose because it
# holds nothing worth protecting. Alpaca and FRED credentials never live in
# this tree at all -- they are /etc/ohcamel/live.env on the server, root-owned.
deploy/.env
deploy/*.env
!deploy/local.env
!deploy/deploy.env.example
!deploy/live.env.example
