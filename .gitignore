# Dune build output
_build/

# Project-local opam switch (the compiler + all deps live here; ~2 GB)
_opam/

# opam install manifests generated by dune
*.install

# macOS
.DS_Store

# Credentials. The engine reads ALPACA_API_KEY, ALPACA_SECRET_KEY and
# FRED_API_KEY from the process environment -- it never reads a committed file.
# These patterns exist so that a local .env used for convenience cannot be
# committed by accident.
.env
*.env
!.env.example

# The live book: positions and limits are account-specific.
# book.example.sexp is committed; book.sexp is not.
book.sexp

