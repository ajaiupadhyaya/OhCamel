; The desk: everything the risk kernel refuses to be.
;
; This library depends on ohcamel, and nothing in lib/ may depend on it. dune
; enforces the direction -- naming ohcamel_desk in lib/dune would be a cycle
; and the build would refuse it -- and CI greps lib/ for the trading host, the
; orders path and Sqlite3, because a cycle catches a dependency and not a
; pasted string. That boundary is invariant 6 now: the kernel cannot place an
; order because it cannot name anything that does.

(library
 (name ohcamel_desk)
 ; websocket and websocket-async: the trade_updates stream, framed by the
 ; libraries lib/dune lists for the market-data stream and opened over that
 ; client's TLS connection.
 (libraries
  ohcamel
  core
  async
  cohttp
  cohttp-async
  uri
  sqlite3
  yojson
  websocket
  websocket-async)
 (preprocess
  (pps ppx_jane))
 ; Coverage instrumentation, declared as lib/dune declares it: OFF unless dune
 ; is invoked with --instrument-with bisect_ppx, which only `make coverage` and
 ; CI's coverage job do. Without it the published figure was the kernel's
 ; alone and said nothing about the code that writes the journal and sends
 ; orders.
 (instrumentation
  (backend bisect_ppx)))

; EXP-A01's two manifests, embedded by name as research_manifests.ml, for
; /api/research/evidence (desk.ml) and the Research page that reads it.
;
; By name, not by glob: dune's glob_files matches inside one directory and the
; manifests live three below this one, so each path is written out, and a
; third manifest is a line added here on purpose rather than a file that
; appears on the page because it was dropped beside the others. Embedded in
; this library and not in lib/, because the evidence is served beside the
; judgements it is evidence for, and lib/ may not depend on anything here.
;
; The delimiter is lib/dune's {ohcamel_json|...|ohcamel_json}, for its reason:
; a closing delimiter inside a manifest would end the literal early, so CI
; greps these two files for it as it greps web/. The manifests are written by
; `json.dumps(..., allow_nan=False)`, so what is embedded is strict JSON, and
; test_intake.ml parses what is served.

(rule
 (targets research_manifests.ml)
 (deps
  ../research/experiments/EXP-A01/manifest.exp_a01_spy.json
  ../research/experiments/EXP-A01/manifest.exp_a01_tlt.json)
 (action
  (with-stdout-to
   research_manifests.ml
   (progn
    (echo "let exp_a01_spy = {ohcamel_json|")
    (cat ../research/experiments/EXP-A01/manifest.exp_a01_spy.json)
    (echo "|ohcamel_json}\n\nlet exp_a01_tlt = {ohcamel_json|")
    (cat ../research/experiments/EXP-A01/manifest.exp_a01_tlt.json)
    (echo "|ohcamel_json}\n")))))
