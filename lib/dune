; `include_subdirs unqualified` folds lib/feed/*.ml into this library as
; top-level modules (Alpaca_ws, Fred_client) rather than requiring a nested
; library. The feed is not a separable component -- it exists only to push
; values into the graph's input cells -- so it should not have its own
; compilation unit boundary.

(include_subdirs unqualified)

(library
 (name ohcamel)
 (public_name ohcamel)
 ; websocket-async brings the Alpaca market data stream; cohttp-async is the
 ; HTTP client for FRED (and the server in Phase 3). Both reach TLS through
 ; conduit-async, which only supports async_ssl as a backend -- hence the
 ; explicit dependency rather than letting it be an optional extra.
 (libraries
  core
  async
  async_ssl
  conduit-async
  cohttp-async
  websocket
  websocket-async
  yojson
  incremental
  owl)
 (preprocess
  (pps ppx_jane ppx_yojson_conv)))
